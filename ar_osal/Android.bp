soong_config_module_type {
    name: "arosal_cc_library_headers",
    module_type: "cc_library_headers",
    config_namespace: "qti",
    bool_variables: ["AUDIO_SDV_APEX_ENABLED"],
    properties: [
        "apex_available",
    ],
}

arosal_cc_library_headers {
    name: "libarosal_headers",
    export_include_dirs: ["api"],
    vendor: true,
    soong_config_variables: {
        AUDIO_SDV_APEX_ENABLED: {
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
        },
    },
}

cc_library_headers {
    name: "api",
    export_include_dirs: ["api"],
    vendor: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    enabled: select(soong_config_variable("qti", "AUDIO_SDV_APEX_ENABLED"), {
        "true": true,
        default: false,
    }),
}

cc_library_headers {
    name: "audio_kernel_headers",
    export_include_dirs: ["api"],
    vendor: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    enabled: select(soong_config_variable("qti", "AUDIO_SDV_APEX_ENABLED"), {
        "true": true,
        default: false,
    }),
}

cc_library_shared {
    name: "liblx-osal",
    owner: "qti",
    vendor: true,
    cflags: [
        "-D_ANDROID_",
        "-DAR_OSAL_USE_CUTILS",
        "-DPROPERTY_TRIGGER",
        "-Wno-int-conversion",
        "-DAR_OSAL_USE_PD_NOTIFIER",
    ],
    srcs: [
        "src/linux/ar_osal_mutex.c",
        "src/linux/ar_osal_thread.c",
        "src/linux/ar_osal_signal.c",
        "src/linux/ar_osal_log.c",
        "src/linux/ar_osal_file_io.c",
        "src/linux/ar_osal_sleep.c",
        "src/linux/ar_osal_mem_op.c",
        "src/linux/ar_osal_heap.c",
        "src/linux/ar_osal_timer.c",
        "src/linux/ar_osal_string.c",
        "src/linux/qcom/ar_osal_log_pkt_op.c",
        "src/linux/qcom/ar_osal_servreg.c",
        "src/linux/qcom/ar_osal_shmem_db.c",
    ],
    include_dirs: [
        "vendor/qcom/opensource/audio-kernel/include",
        "vendor/qcom/opensource/args/ar_osal/api/",
        "system/memory/libion/include/ion",
        "system/memory/libion/kernel-headers",
    ],
    shared_libs: [
        "liblog",
        "libdiag",
        "libcutils",
        "libpdmapper",
        "libpdnotifier",
        "libion"
    ],
    header_libs: [
        "audio_kernel_headers",
        "libarosal_headers",
        "qti_audio_kernel_uapi",
        "libdiag_headers",
        "vendor_common_inc",
        "libpdmapper_headers",
        "libpdnotifier_headers",
        "libqmi_legacy_headers",
        "libqmi_common_headers"
    ],
    export_include_dirs: [
        "api",
    ],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    enabled: select(soong_config_variable("qti", "AUDIO_SDV_APEX_ENABLED"), {
        "true": true,
        default: false,
    }),
}
