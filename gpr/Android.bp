cc_library_shared {
    name: "libar-gpr",
    owner: "qti",
    vendor: true,

    srcs: [
        "core/src/gpr_drv.c",
        "core/src/gpr_list.c",
        "core/src/gpr_main.c",
        "core/src/gpr_memq.c",
        "core/src/gpr_drv_island.c",
        "core/src/gpr_list_island.c",
        "core/src/gpr_memq_island.c",
        "core/src/hash_based/gpr_session.c",
        "core/src/hash_based/gpr_session_island.c",
        "ext/dynamic_allocation/src/gpr_dynamic_allocation.c",
        "ext/logging/src/gpr_log_generic.c",
        "ext/logging/stub_src/gpr_log_diag_stub.c",
        "datalinks/gpr_lx/src/gpr_lx.c",
        "platform/linux/gpr_init_lx_wrapper.c"
        ],

    shared_libs: [
        "liblx-osal",
        "libcutils",
        "liblog"
        ],

    include_dirs: [
        "vendor/qcom/opensource/args/gpr/ext/logging/inc",
        "vendor/qcom/opensource/args/gpr/api",
        "vendor/qcom/opensource/args/gpr/api/private",
        "vendor/qcom/opensource/args/gpr/core/inc",
        "vendor/qcom/opensource/args/gpr/core/inc/ar_utils/generic",
        "vendor/qcom/opensource/args/gpr/core/src",
        "vendor/qcom/opensource/args/gpr/ext/dynamic_allocation/inc",
        "vendor/qcom/opensource/args/gpr/ext/logging/inc",
        "vendor/qcom/opensource/args/gpr/datalinks/gpr_lx/inc"
        ],

    export_include_dirs: [
        "api"
        ],

    cflags: [
        "-D_ANDROID_",
        "-DSESSION_ARRAY_SIZE=200",
        "-DGPR_USE_CUTILS"
        ]
    + select(soong_config_variable("qti", "TARGET_SUPPORTS_WEAR_AON"), {
        true: ["-DPLATFORM_SLATE"],
        default: [],
    }),

    header_libs: [
        "api",
    ],

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",
}
