cc_library_shared {

    name: "liblx-ar_util",
    owner: "qti",
    vendor: true,

    srcs: [
        "src/ar_util_list.c",
        "src/ar_util_data_log.c",
        "src/ar_util_err_detection.c"
        ],

    shared_libs: [
        "liblog",
        "liblx-osal"
        ],

    include_dirs: [
        "vendor/qcom/opensource/args/ar_util/api",
        "vendor/qcom/opensource/args/ar_util/inc"
        ],

    export_include_dirs: [
        "api"
        ],

    cflags: [
        "-D_ANDROID_"
        ],

    header_libs: [
        "libspf-headers"
        ],

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",
}


cc_binary {

    name: "ar_util_in_test_example",
    vendor: true,

    srcs: [
        "test/src/ar_osal_mutex_thread.c",
        "test/src/ar_osal_signal_thread.c",
        "test/src/ar_osal_test.c",
        "test/src/ar_osal_test_service.c",
        "test/src/ar_test_file_io.c",
        "test/src/ar_test_heap.c",
        "test/src/ar_test_list.c",
        "test/src/ar_test_mem_op.c",
        "test/src/ar_test_shmem.c",
        "test/src/ar_test_sleep.c",
        "test/src/ar_test_string.c",
        "test/src/ar_test_data_log.c",
        "test/src/ar_test_log_pkt_op.c"
        ],

    shared_libs: [
        "liblog",
        "liblx-ar_util",
        "liblx-osal"
        ],

    include_dirs: [
        "vendor/qcom/opensource/args/ar_util/api",
        "vendor/qcom/opensource/args/ar_util/test/inc",
        "vendor/qcom/opensource/args/ar_util/inc"
        ],

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",
}

